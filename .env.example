POSTGRES_USER=nodeargus
POSTGRES_PASSWORD=nodeargus_password
POSTGRES_DB=nodeargus
POSTGRES_URL=postgresql://nodeargus:nodeargus_password@localhost:5432/nodeargus
POSTGRES_ASYNC_URL=postgresql+asyncpg://nodeargus:nodeargus_password@localhost:5432/nodeargus
# Separate DB for DB-backed pytest suites that drop/recreate tables. Create it with:
#   docker compose exec postgres psql -U nodeargus -c "CREATE DATABASE nodeargus_test;"
# POSTGRES_TEST_DATABASE=nodeargus_test
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_LICENSE_KEY=
GEOIP_MIRROR_URL=
GEOIP_AUTO_UPDATE=false

# OWASP Amass integration settings.
# Active brute-force recon generates notable DNS noise, so it is disabled by
# default. Set to true only when authorised and within Rules of Engagement.
ALLOW_ACTIVE_RECON=false
AMASS_CONF_PATH=/root/.config/amass/config.yaml
AMASS_WORDLIST_PATH=/usr/share/wordlists/amass/subdomains-top1mil-5000.txt

# WAF Bypass Mode settings for Nuclei.
# Generates significantly more traffic and can trigger WAF blocking, IDS/IPS
# alerts, server load, and rate limiting/CAPTCHA responses. Set to true only
# when authorised within Rules of Engagement.
ALLOW_WAF_BYPASS=false
WAF_BYPASS_RATE_LIMIT=150
WAF_BYPASS_CONCURRENCY=30
